[run]
# The package and the deprecated top-level aliases of its modules
source =
    mmsbm
    expectation_maximization
    data_handler
    helpers
    backend
    logger
    kernels_numpy
    kernels_numba
    kernels_cupy

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    if self.debug:
    raise NotImplementedError
    if __name__ == .__main__.:
    pass
    raise ImportError

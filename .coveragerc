[run]
# Every module of the package (setup.py installs them as top-level modules)
source =
    mmsbm
    expectation_maximization
    data_handler
    helpers
    backend
    logger
    kernels_numpy
    kernels_numba
    kernels_cupy

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    if self.debug:
    raise NotImplementedError
    if __name__ == .__main__.:
    pass
    raise ImportError
